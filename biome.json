{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": [
              "utility",
              "theme",
              "apply",
              "tailwind",
              "layer",
              "config"
            ]
          }
        }
      }
    }
  }
}
