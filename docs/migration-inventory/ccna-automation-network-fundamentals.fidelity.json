          "rowspan": null
        },
        {
          "tag": "td",
          "text": "QoS設定、帯域増強、キャッシュの活用",
          "colspan": null,
          "rowspan": null
        }
      ],
      [
        {
          "tag": "td",
          "text": "遅延（Latency）／RTTの増大",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "リアルタイム性の低下（音声・映像品質の劣化）",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "CDNの活用、エッジコンピューティングの活用",
          "colspan": null,
          "rowspan": null
        }
      ],
      [
        {
          "tag": "td",
          "text": "MTU／パケットフラグメンテーション",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "パケット分割によるオーバーヘッド、通信エラー",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "MTUサイズの調整、Path MTU Discoveryの利用",
          "colspan": null,
          "rowspan": null
        }
      ],
      [
        {
          "tag": "td",
          "text": "パケットロス",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "再送増加によるスループット低下",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "信頼性の高いプロトコルの選択、QoSの適用",
          "colspan": null,
          "rowspan": null
        }
      ],
      [
        {
          "tag": "td",
          "text": "ファイアウォール／ACLによる通信制限",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "特定ポート・プロトコルの通信が失敗する",
