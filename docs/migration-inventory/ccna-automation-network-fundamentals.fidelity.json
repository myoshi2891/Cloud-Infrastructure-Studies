        }
      ],
      [
        {
          "tag": "td",
          "text": "特定サーバーの特定ポートにだけ接続できない",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "Transport Port Blocked",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "対象ポートへの接続テスト、FW/ACLのログ確認",
          "colspan": null,
          "rowspan": null
        }
      ],
      [
        {
          "tag": "td",
          "text": "社外から社内のアプリケーションに到達できない",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "NAT Problem",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "NAT変換テーブル、グローバルIPの割当状況の確認",
          "colspan": null,
          "rowspan": null
        }
      ],
      [
        {
          "tag": "td",
          "text": "特定URL・宛先だけアクセスできない",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "Proxy設定の誤り",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "プロキシの除外リスト・認証設定の確認",
          "colspan": null,
          "rowspan": null
        }
      ],
      [
        {
          "tag": "td",
          "text": "拠点間の通信だけ失敗する",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "VPN Problem",
          "colspan": null,
          "rowspan": null
        },
        {
          "tag": "td",
          "text": "VPNトンネルの状態、ルーティング配布状況の確認",
