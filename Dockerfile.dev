# syntax=docker/dockerfile:1.7
# 開発用 Dockerfile — hot reload 前提
# ソースは compose の bind mount で外部から差し込む想定

ARG BUN_VERSION=1-alpine

FROM oven/bun:${BUN_VERSION}
WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Turbopack / Next dev はファイル監視に inotify を使う。
# bind mount 経由のイベント取りこぼし対策としてポーリングを有効化。
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

COPY package.json bun.lock* ./

# 依存関係のインストール (本番環境と合わせ --frozen-lockfile が望ましいが、dev環境では追加パッケージを入れることも多いため一旦そのまま)
RUN bun install

# ソースコードは compose 側で volume マウントされるため、
# ここでは特にコピーしない（イメージを軽量に保つ）

# 非 root ユーザーで実行
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs nextjs \
 && mkdir -p /app/.next \
 && chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 3000

CMD ["bun", "run", "dev"]
